service openvswitch-switch start
ovs-vsctl add-br sw1
ovs-vsctl set bridge sw1 stp_enable=false

# 1 号口：access VLAN100 -> PCA
ovs-vsctl add-port sw1 eth0 tag=100

# 9 号口：access VLAN200 -> PCB
ovs-vsctl add-port sw1 eth1 tag=200

# 24 号口：trunk -> 路由器 F0/0
ovs-vsctl add-port sw1 eth2 trunks=100,200

ip link set sw1 up
