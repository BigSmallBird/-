# trunk 物理口 up，不配 IP
ip link set eth0 up

# ① 单臂路由：F0/0.1  encapsulation dot1Q 100  ip address 192.168.1.1/24
# ② 三层交换机：interface vlan 100  ip address 192.168.1.1/24
ip link add link eth0 name eth0.100 type vlan id 100
ip addr add 192.168.1.1/24 dev eth0.100
ip link set eth0.100 up

# ① 单臂路由：F0/0.2  encapsulation dot1Q 200  ip address 192.168.2.1/24
# ② 三层交换机：interface vlan 200  ip address 192.168.2.1/24
ip link add link eth0 name eth0.200 type vlan id 200
ip addr add 192.168.2.1/24 dev eth0.200
ip link set eth0.200 up
