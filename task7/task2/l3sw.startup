# DCRS552 的 interface vlan 1：VLAN 1 内所有 PC 的网关
ip addr add 192.168.1.1/24 dev eth0
ip link set eth0 up

# ---------------- 交换机的 DHCP 服务 ----------------
# kathara/base 用 dnsmasq 同时提供 DHCP + DNS
cat > /etc/dnsmasq.conf <<'EOF'
# 相当于在 VLAN 1 这个广播域上提供服务
interface=eth0
bind-interfaces

# 地址池 192.168.1.100 ~ 192.168.1.200，租期 12 小时
dhcp-range=192.168.1.100,192.168.1.200,255.255.255.0,12h

# option 3：默认网关 = 交换机的 VLAN1 接口
dhcp-option=3,192.168.1.1

# option 6：DNS
dhcp-option=6,192.168.1.1

dhcp-leasefile=/var/lib/misc/dnsmasq.leases
log-dhcp
EOF

service dnsmasq start
