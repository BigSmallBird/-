# 物理口 up，但不配 IP —— 只做 trunk 承载
ip link set eth0 up

# 对应 Cisco: interface f0/0.100 / encapsulation dot1Q 100 / ip address
ip link add link eth0 name eth0.100 type vlan id 100
ip addr add 192.168.1.1/24 dev eth0.100
ip link set eth0.100 up

# 对应 Cisco: interface f0/0.200 / encapsulation dot1Q 200 / ip address
ip link add link eth0 name eth0.200 type vlan id 200
ip addr add 192.168.2.1/24 dev eth0.200
ip link set eth0.200 up
