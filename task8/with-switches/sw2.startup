# 防止在 macOS/OrbStack 上触发 OVS hairpin 广播风暴
if uname -r | grep -qi orbstack; then
    echo "ERROR: OVS switch topology would cause a broadcast storm on OrbStack."
    echo "Use the no-switch lab in the parent folder, or run this in Kali/Linux."
    exit 1
fi

service openvswitch-switch start
ovs-vsctl add-br sw2
ovs-vsctl set bridge sw2 stp_enable=false

# 两个 access 口都属于 VLAN 1
ovs-vsctl add-port sw2 eth0 tag=1
ovs-vsctl add-port sw2 eth1 tag=1
ip link set sw2 up
