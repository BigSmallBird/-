# F0/0 -> PC A
ip addr add 192.168.1.1/24 dev eth0
ip link set eth0 up

# S0/2 -> r2
ip addr add 211.1.1.1/24 dev eth1
ip link set eth1 up

# 到 PC B 所在网段的静态路由，下一跳是 r2 的 S0/3
ip route replace 211.2.2.0/24 via 211.1.1.2

# ------------------------------------------------------------------
# 实验八 ②：NAT（源地址转换 / NAPT）
# 把从 eth0（内网）出来、从 eth1（外网口）出去的包，
# 源地址统一换成 S0/2 的公网地址 211.1.1.1。
# 这样 r2 看到的源地址不再是私有地址，过滤规则不再命中，
# 回程也能直接回到 211.1.1.1，再由 conntrack 还原给 192.168.1.10。
# ------------------------------------------------------------------
iptables -t nat -A POSTROUTING -o eth1 -j SNAT --to-source 211.1.1.1
