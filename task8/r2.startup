# F0/0 -> PC B
ip addr add 211.2.2.1/24 dev eth0
ip link set eth0 up

# S0/3 -> r1
ip addr add 211.1.1.2/24 dev eth1
ip link set eth1 up

# 到 PC A 所在网段的静态路由，下一跳是 r1 的 S0/2
ip route replace 192.168.1.0/24 via 211.1.1.1

# ------------------------------------------------------------------
# 模拟"公网侧拒收私有源地址"（RFC1918 ingress filtering / uRPF）：
# 真实 ISP 路由器不会转发源地址是 192.168.x.x 的包。
# 有了这条，PCA ping 211.2.2.2 才不通 —— 这正是实验八 ① 的现象。
# 只过滤「转发」流量（FORWARD 链），
# 所以 ping 211.1.1.2（路由器自己回应）仍然通。
# ------------------------------------------------------------------
iptables -A FORWARD -o eth0 -s 192.168.1.0/24 -j DROP
